# Supabase — điền từ project dashboard (Settings → API / Database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — CHỈ dùng server-side (seed script, admin). Không expose ra client.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (dùng cho db-apply.ts / seed.ts). Lấy ở Settings → Database → Connection string (URI).
DATABASE_URL=
